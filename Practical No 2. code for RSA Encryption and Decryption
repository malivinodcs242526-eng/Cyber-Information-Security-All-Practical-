## GUI ##

import tkinter as tk

def gcd(a, b):
    while b != 0:
        a, b = b, a % b
    return a
def mod_inverse(e, phi):
    for d in range(1, phi):
        if (d * e) % phi == 1:
            return d
    return None

p = 61
q = 53

n = p * q
phi = (p - 1) * (q - 1)

e = 17

while gcd(e, phi) != 1:
    e += 2

d = mod_inverse(e, phi)

def encrypt():
    message = entry.get().strip()

    enc_entry.config(state="normal")
    enc_entry.delete(0, tk.END)

    dec_entry.config(state="normal")
    dec_entry.delete(0, tk.END)

    if message == "":
        enc_entry.insert(0, "Please enter a message!")
        enc_entry.config(state="readonly")
        dec_entry.config(state="readonly")
        return

    encrypted = [pow(ord(ch), e, n) for ch in message]

    enc_entry.insert(0, str(encrypted))

    enc_entry.config(state="readonly")
    dec_entry.config(state="readonly")

def decrypt():
    try:
        encrypted = eval(enc_entry.get())

        decrypted = ''.join(chr(pow(ch, d, n)) for ch in encrypted)

        dec_entry.config(state="normal")
        dec_entry.delete(0, tk.END)
        dec_entry.insert(0, decrypted)
        dec_entry.config(state="readonly")

    except:
        dec_entry.config(state="normal")
        dec_entry.delete(0, tk.END)
        dec_entry.insert(0, "Invalid Cipher!")
        dec_entry.config(state="readonly")

def clear_all():
    entry.delete(0, tk.END)

    enc_entry.config(state="normal")
    enc_entry.delete(0, tk.END)
    enc_entry.config(state="readonly")

    dec_entry.config(state="normal")
    dec_entry.delete(0, tk.END)
    dec_entry.config(state="readonly")

