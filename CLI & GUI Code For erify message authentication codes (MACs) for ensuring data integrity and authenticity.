CLI 
import hmac
import hashlib

msg = input("Enter the message: ")
key = input("Enter the secret key: ")

# Generate MAC
mac = hmac.new(key.encode(), msg.encode(), hashlib.sha256).hexdigest()

print("\nMessage:", msg)
print("Generated MAC:", mac)

# Verify MAC
verify = input("\nEnter the message to verify: ")

if hmac.compare_digest(mac, hmac.new(key.encode(), verify.encode(), hashlib.sha256).hexdigest()):
    print("MAC Verification Successful: Message is authentic.")
else:
    print("MAC Verification Failed: Message has been altered.")





GUI 
import tkinter as tk
from tkinter import messagebox
import hmac
import hashlib


def generate_mac():
    msg = message_entry.get("1.0", tk.END).strip()
    key = key_entry.get()

    if not msg or not key:
        messagebox.showerror("Error", "Enter both Message and Secret Key!")
        return

    mac = hmac.new(key.encode(), msg.encode(), hashlib.sha256).hexdigest()

    output.config(state="normal")
    output.delete("1.0", tk.END)
    output.insert(tk.END, f"Message:\n{msg}\n\n")
    output.insert(tk.END, f"Generated MAC:\n{mac}")
    output.config(state="disabled")


def verify_mac():
    msg = message_entry.get("1.0", tk.END).strip()
    key = key_entry.get()
    verify = verify_entry.get("1.0", tk.END).strip()

    if not msg or not key or not verify:
        messagebox.showerror("Error", "Fill all fields!")
        return

    mac = hmac.new(key.encode(), msg.encode(), hashlib.sha256).hexdigest()
    verify_mac = hmac.new(key.encode(), verify.encode(), hashlib.sha256).hexdigest()

    if hmac.compare_digest(mac, verify_mac):
        result.config(text="✔ MAC Verification Successful!\nMessage is Authentic.",
                      fg="#00FF00")
    else:
        result.config(text="✖ MAC Verification Failed!\nMessage has been Altered.",
                      fg="red")



